# Exposed to the browser and safe only with row-level security enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional for a local dashboard only. Leave unset on hosted deployments.
NEXT_PUBLIC_FDAX_LOCAL_WORKER_URL=http://127.0.0.1:8787

# Set only in the local Python worker environment, never in this web app.
# SUPABASE_SECRET_KEY=
# FDAX_OWNER_ID=
